# Copy to xinchat-api.env and run ./deploy/rotate-jwt-secret.sh before production.
# Never commit real secrets. deploy/xinchat-api.env is gitignored.
# Legacy QCHAT_* names are still read as a fallback until you rename them.

XINCHAT_HTTP_ADDR=:8080
XINCHAT_DATABASE_URL=postgres://xinchat:xinchat@localhost:5432/xinchat?sslmode=disable
XINCHAT_REDIS_URL=redis://localhost:6379/0
# Optional: when reachable, Redis backs WS fan-out across API instances and
# shared session-revoke markers. If Redis is down the API still starts
# (single-node in-process hub).
# Weak default for local only — rotate for any shared/production host.
XINCHAT_JWT_SECRET=dev-xinchat-secret-change-me
# Set to production to refuse the weak JWT default at API startup.
XINCHAT_ENV=development
XINCHAT_CORS_ORIGIN=*
XINCHAT_OBJECT_STORAGE_URL=http://localhost:9000
XINCHAT_BUCKET=xinchat
# MinIO defaults from docker-compose. Leave URL empty to force local disk only.
XINCHAT_OBJECT_STORAGE_ACCESS_KEY=xinchatminio
XINCHAT_OBJECT_STORAGE_SECRET_KEY=xinchatminio123

# Optional: Giphy GIF search for the composer (free key at https://developers.giphy.com/).
# Leave empty to disable GIF search with a clear API error. Never put this in NEXT_PUBLIC_*.
# XINCHAT_GIPHY_API_KEY=

# --- Push (Web + mobile) ---
# Web Push VAPID (dev defaults exist in code; rotate for production).
# XINCHAT_VAPID_PUBLIC=
# XINCHAT_VAPID_PRIVATE=
# XINCHAT_VAPID_SUBJECT=mailto:admin@example.com

# Expo Push (optional fallback — weak on China OEM devices without Google services).
# XINCHAT_EXPO_PUSH_ENABLED=true
# XINCHAT_EXPO_ACCESS_TOKEN=

# Native FCM HTTP v1 (optional; usually unused in China mainland).
# XINCHAT_FCM_PROJECT_ID=
# XINCHAT_FCM_CREDENTIALS_JSON=/path/to/firebase-adminsdk.json

# Native APNs HTTP/2 (optional; Getui can also cover iOS when configured).
# XINCHAT_APNS_KEY_ID=
# XINCHAT_APNS_TEAM_ID=
# XINCHAT_APNS_BUNDLE_ID=com.xinchat.mobile
# XINCHAT_APNS_KEY_PATH=/path/to/AuthKey_XXXXX.p8
# XINCHAT_APNS_PRODUCTION=1

# --- Getui 个推 (required for China mainland manufacturer push) ---
# Create app at https://dev.getui.com — enable Huawei/Xiaomi/OPPO/vivo/Honor channels there.
# XINCHAT_GETUI_ENABLED=true
# XINCHAT_GETUI_APP_ID=
# XINCHAT_GETUI_APP_KEY=
# XINCHAT_GETUI_MASTER_SECRET=

# --- Backup / DR status (admin console) ---
# Must match deploy/backup.sh output root so GET /v1/admin/backup/status works.
# XINCHAT_BACKUP_DIR=/root/xinchat/backups

# LiveKit (prefer sourcing deploy/generated/media.env after ./deploy/render-media-config.sh).
# Keys must match deploy/generated/livekit.yaml. Do not hardcode a machine IP in git.
# XINCHAT_ENV=production (and render --strict) refuse the defaults below — set unique values.
# LIVEKIT_URL=ws://YOUR_HOST:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret-that-is-at-least-32-characters-long
# TURN_USER=xinchat
# TURN_PASS=xinchatturnsecret

# Validate before redeploy: ./deploy/check-env.sh
# Require LiveKit healthy: ./deploy/redeploy.sh --require-media
