[Unit]
Description=XinChat API (Go backend)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/xinchat/services/api
# media.env is optional (generated by deploy/render-media-config.sh on each host).
EnvironmentFile=-/root/xinchat/deploy/generated/media.env
EnvironmentFile=-/root/xinchat/deploy/xinchat-api.env
ExecStart=/root/xinchat/services/api/bin/xinchat-api
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xinchat-api

[Install]
WantedBy=multi-user.target
